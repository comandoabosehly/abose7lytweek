<Window x:Class="Abose7ly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="abose7ly | PUBG GameLoop Toolkit" Height="760" Width="1120"
        MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="abose7ly" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="PUBG GameLoop Toolkit • أدوات تشخيص وضبط آمنة" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#172033" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
        <TextBlock x:Name="StatusBadge" Text="جاهز للفحص" Foreground="#93C5FD" FontWeight="SemiBold"/>
      </Border>
    </DockPanel>
    <Border Grid.Row="1" Background="#172033" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="تشخيص المحاكي" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="DetectionText" Text="اضغط «فحص الجهاز» للبحث عن مسارات GameLoop الشائعة وTenstore Android Connect." TextWrapping="Wrap" Foreground="#CBD5E1"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="فحص الجهاز" Click="Detect_Click"/>
          <Button Content="فتح مجلد الإعدادات" Click="OpenSettings_Click" Background="#334155"/>
          <Button Content="عرض إرشادات السلامة" Click="Safety_Click" Background="#334155"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <UniformGrid Columns="2">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,8,8">
          <StackPanel>
            <TextBlock Text="ملفات PUBG وKeymapping" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="فحص أماكن الملفات المعروفة فقط. احتفظ بنسخة احتياطية قبل أي تعديل يدوي." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
            <Button Content="فتح مسارات المحاكي المكتشفة" Click="OpenDetected_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="8,0,0,8">
          <StackPanel>
            <TextBlock Text="إعدادات العرض والأداء" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="إرشادات إعداد الرسوم داخل المحاكي واللعبة؛ لا يوجد وعد بفتح FPS غير مدعوم." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
            <Button Content="عرض توصيات الأداء" Click="Performance_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,8,8,0">
          <StackPanel>
            <TextBlock Text="تنظيف المؤقتات" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="فتح مجلد Temp للمراجعة اليدوية فقط؛ لا نحذف ملفات تلقائياً." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
            <Button Content="فتح مجلد Temp" Click="OpenTemp_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="8,8,0,0">
          <StackPanel>
            <TextBlock Text="النسخ القديمة / الرجوع" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="استخدم فقط مثبتاً رسمياً موثوقاً واحتفظ بنسخة من ملفاتك." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
            <Button Content="إرشادات الرجوع الآمن" Click="Rollback_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="نسخة تشخيصية أولية. لا تتجاوز anti-cheat ولا تعدّل ملفات اللعبة تلقائياً." Foreground="#94A3B8" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>

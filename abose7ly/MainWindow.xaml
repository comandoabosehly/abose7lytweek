<Window x:Class="Abose7ly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="abose7ly | PUBG GameLoop Toolkit" Height="800" Width="1120"
        MinHeight="680" MinWidth="950" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="abose7ly" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="PUBG GameLoop Toolkit • أداة عامة لتشخيص المحاكي وضبط آمن" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#172033" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
        <TextBlock x:Name="StatusBadge" Text="جاهز للفحص" Foreground="#93C5FD" FontWeight="SemiBold"/>
      </Border>
    </DockPanel>
    <Border Grid.Row="1" Background="#172033" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="تشخيص المحاكي والجهاز" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="DetectionText" Text="اضغط «فحص الجهاز» للبحث عن GameLoop الصيني والعادي وTenstore." TextWrapping="Wrap" Foreground="#CBD5E1"/>
        <TextBlock x:Name="HardwareText" Text="معلومات الجهاز ستظهر بعد الفحص." TextWrapping="Wrap" Foreground="#93C5FD" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="فحص الجهاز" Click="Detect_Click"/>
          <Button Content="اختيار مجلد المحاكي" Click="ChooseFolder_Click" Background="#334155"/>
          <Button Content="فتح مجلد الإعدادات" Click="OpenSettings_Click" Background="#334155"/>
          <Button Content="إرشادات السلامة" Click="Safety_Click" Background="#334155"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="اختيار نسخة اللعبة" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="اختيار تنظيمي لتسجيل النسخة التي تختبرها؛ لا يثبت اللعبة ولا يعدّل ملفاتها." TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#CBD5E1"/>
            <ComboBox x:Name="RegionBox" Width="300" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="RegionBox_SelectionChanged">
              <ComboBoxItem Content="PUBG Mobile Global — العالمية"/>
              <ComboBoxItem Content="Game for Peace — الصينية"/>
              <ComboBoxItem Content="PUBG Mobile Taiwan — التايوانية"/>
              <ComboBoxItem Content="PUBG Mobile KR — الكورية"/>
              <ComboBoxItem Content="PUBG Mobile Vietnam — الفيتنامية"/>
            </ComboBox>
            <TextBlock x:Name="RegionText" Text="اختَر النسخة التي تريد اختبارها." TextWrapping="Wrap" Foreground="#93C5FD" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <UniformGrid Columns="2">
          <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,8,8">
            <StackPanel>
              <TextBlock Text="ملفات PUBG وKey Mapping" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="فتح مجلد المحاكي للفحص اليدوي. لا تغيّر ملفات اللعبة قبل عمل نسخة احتياطية." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
              <Button Content="فتح مسار المحاكي" Click="OpenDetected_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="8,0,0,8">
            <StackPanel>
              <TextBlock Text="إعدادات العرض والأداء" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="توصيات مختلفة للأجهزة الضعيفة والمتوسطة؛ لا يتم فرض FPS غير مدعوم." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
              <Button Content="عرض توصيات الأداء" Click="Performance_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,8,8,0">
            <StackPanel>
              <TextBlock Text="تنظيف الملفات المؤقتة" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="فحص عدد الملفات وحجمها ثم فتح المجلد للمراجعة اليدوية؛ لا حذف تلقائي." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
              <Button Content="فحص وفتح مجلد Temp" Click="OpenTemp_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="8,8,0,0">
            <StackPanel>
              <TextBlock Text="النسخ القديمة / الرجوع" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="استخدم مصدرًا رسميًا فقط؛ قد تمنع الخوادم الإصدارات القديمة." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#CBD5E1"/>
              <Button Content="إرشادات الرجوع الآمن" Click="Rollback_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="نسخة تطويرية. الميزات التي تعدّل اللعبة أو تتجاوز anti-cheat غير مدعومة؛ يجب اختبار كل محاكي وإصدار قبل إعلان التوافق." Foreground="#94A3B8" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
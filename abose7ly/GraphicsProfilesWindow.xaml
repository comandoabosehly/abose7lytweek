<Window x:Class="Abose7ly.GraphicsProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="abose7ly | Graphics &amp; FPS" Height="620" Width="850"
        WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#E5E7EB">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="إعدادات الجرافيك ومعدل الإطارات" FontSize="25" FontWeight="Bold" Foreground="#A78BFA"/>
      <TextBlock Text="اكتشاف متعدد للمحاكيات مع ملفات إعدادات مستقلة لكل محاكي." Foreground="#CBD5E1" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#172033" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="المحاكي المستهدف" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox x:Name="EmulatorBox" SelectedIndex="0" Height="34">
          <ComboBoxItem Content="اكتشاف تلقائي — كل المحاكيات"/>
          <ComboBoxItem Content="GameLoop Classic"/>
          <ComboBoxItem Content="GameLoop الجديد"/>
          <ComboBoxItem Content="Tenstore Android Connect"/>
        </ComboBox>
        <WrapPanel Margin="0,10,0,0">
          <Button Content="فحص المحاكيات والجهاز" Click="Scan_Click" Padding="14,7" Margin="0,0,8,0"/>
          <Button Content="اتصال ADB وفحص PUBG" Click="AdbScan_Click" Padding="14,7" Background="#0F766E"/>
          <Button Content="فتح إعدادات المحاكي" Click="OpenSettings_Click" Padding="14,7" Background="#334155"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="#172033" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="أوضاع الأداء" FontSize="18" FontWeight="SemiBold"/>
            <RadioButton x:Name="UltraRadio" Content="Ultra HD + 120 FPS — أعلى جودة (إذا كانت مدعومة)" IsChecked="True" Margin="0,10,0,5"/>
            <RadioButton x:Name="SmoothRadio" Content="Smooth + 120 FPS — أولوية للسلاسة" Margin="0,5"/>
            <RadioButton x:Name="BalancedRadio" Content="Balanced — إعداد متوازن" Margin="0,5"/>
            <TextBlock Text="اختيار الوضع لا يفرض FPS غير مدعوم. الحد الفعلي تحدده اللعبة وإصدار المحاكي وقدرة الجهاز." TextWrapping="Wrap" Foreground="#FBBF24" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#172033" CornerRadius="10" Padding="14">
          <StackPanel>
            <TextBlock Text="نتيجة الفحص" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" Background="#0B1220" Foreground="#CBD5E1" BorderBrush="#334155" Padding="10" Text="اضغط فحص المحاكيات والجهاز لعرض النتائج."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button Content="تطبيق / إرشادات الوضع المختار" Click="Apply_Click" Padding="16,9" Background="#6D28D9"/>
      <Button Content="إغلاق" Click="Close_Click" Padding="16,9" Background="#334155"/>
    </WrapPanel>
  </Grid>
</Window>